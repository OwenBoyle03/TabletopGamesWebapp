doctype html

html
    head
        title Please enter the lobby password
        link(rel='stylesheet', href='../css/index.css')

    body
        div(class='centered')

            h1 Please enter the lobby password below:

            br
            br

            form(name="passwordInput", method="POST")
                if errorMsg
                    h2 #{errorMsg}
                    input(name="password", type="password", id="passwordInputField", value=enteredPassword)
                else
                    input(name="password", type="password", id="passwordInputField", placeholder="Enter the Lobby Password")
                input(type="submit", hidden)

        //script(src="./js/chooseUsername.js")