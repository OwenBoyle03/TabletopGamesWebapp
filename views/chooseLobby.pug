doctype html

html
    head
        title Choose an ongoing game
        link(rel='stylesheet', href='./css/chooseLobby.css')

            body
                div(id='main')
                   div(id='lobbies')
                    if openLobbies.length < 1
                        h2 No lobbies open currently
                    else
                        form(name="lobbyChoice", method="POST")
                            input(name="username", type="text", id="usernameInputField", value=enteredName)
                            input(type="submit", hidden)

            script(src="https://cdn.socket.io/4.8.1/socket.io.min.js", integrity="sha384-mkQ3/7FUtcGyoppY6bz/PORYoGqOl7/aSUMn2ymDOJcapfS6PHqxhRTMh1RR0Q6+", crossorigin="anonymous")
            script(src="./js/GameModel.js")
            script(src="./js/ViewCard.js")
            script(src="./js/GameView.js")
            script(src="./js/GameController.js")