doctype html

html
    head
        title Board Games
        link(rel='stylesheet', href='./css/index.css')

    body
        div(class='centered')

            h1 Board Games

            br
            br

            form(name="usernameInput", method="POST")
                if errorMsg
                    h2 #{errorMsg}
                    input(name="username", type="text", id="usernameInputField", value=enteredName)
                else
                    input(name="username", type="text", id="usernameInputField", placeholder="Enter your username")
                input(type="submit", hidden)

